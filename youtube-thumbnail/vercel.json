{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "public/**/*",
            "use": "@vercel/static"
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "X-Frame-Options", "value": "ALLOWALL" },
                { "key": "Content-Security-Policy", "value": "default-src * 'unsafe-inline' 'unsafe-eval'; frame-ancestors *" }
            ]
        }
    ]
} 