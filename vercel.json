{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/youtube-thumbnail-downloader", "dest": "/youtube-thumbnail-downloader/index.html" },
    { "src": "/youtube-thumbnail-downloader/(.*)", "dest": "/youtube-thumbnail-downloader/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "default-src * 'unsafe-inline' 'unsafe-eval'; frame-ancestors *" }
      ]
    }
  ]
} 
