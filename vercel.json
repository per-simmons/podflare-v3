{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/youtube-thumbnail", "destination": "/youtube-thumbnail/index.html" },
    { "source": "/youtube-thumbnail/(.*)", "destination": "/youtube-thumbnail/$1" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "default-src * 'unsafe-inline' 'unsafe-eval'; frame-ancestors *" }
      ]
    }
  ],
  "errorPages": {
    "404": "/404.html"
  }
} 